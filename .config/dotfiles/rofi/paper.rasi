* {
    bg:          #F9F6F0;
    fg:          #000000;
    accent:      #484BA4;
    muted:       #D5CFC5;
    
    background-color: transparent;
    text-color:       @fg;
    font:             "DejaVu Sans Mono 11";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @fg;
    border-radius:    0px;
    padding:          20px;
    width:            500px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  15px;
}

inputbar {
    background-color: @bg;
    border:           0px 0px 1px 0px;
    border-color:     @muted;
    padding:          0px 0px 10px 0px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:  @accent;
    margin:      0px 10px 0px 0px;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @muted;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: true;
    spacing:      5px;
}

element {
    padding:       8px 12px;
    border-radius: 0px;
}

element normal.normal {
    background-color: @bg;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element-text {
    text-color: inherit;
}
