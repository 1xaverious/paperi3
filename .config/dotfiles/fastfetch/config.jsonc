{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {"1": "black", "2": "black"},
    "source": "$HOME/.config/fastfetch/rabbit",
  },
     "padding": {
	"top": 9
},
"display": {
	"separator": ": ",
	"color": {
	     "keys": "black",
	     "title": "black"
	}
},
"modules": [
  {
    "type": "title"
  },
{
  "type": "custom",
  "format": "..............................."
},
{
  "type": "os",
  "typecolor": "black",
  "key": "OS",
  "keycolor": "black"
},
{
  "type": "memory",
  "key": "ram",
  "format": "{used}/{total}",
  "keycolor": "black"
},
{
  "type": "cpu",
  "key": "cpu",
  "format": "{march}",
  "keycolor": "black"
},
{
  "type": "terminal",
  "key": "term",
  "format": "{process-name}"
},
{
  "type": "disk",
  "format": "{filesystem}",
  "key": "fs",
  "keycolor": "black"
},
{
  "type": "shell",
  "key": "shell",
  "format": "{process-name}",
  "keycolor": "black"
},
{
  "type": "uptime",
  "key": "uptime",
  "keycolor": "black"
}
]
}
